---
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import heroImage from "../assets/images/hero-home.avif";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";
---

<ContentLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  heroImage={heroImage}
  heroImageAlt="A smartphone held up like a devotional object, its screen a stained-glass grid of flat gold and black shapes radiating light, in a two-ink risograph print"
  {...siteConfig}
>
  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <h2>What you will do</h2>
  <p>
    Twelve weeks of doctrine, each one training a practice you already
    half-know how to do and giving it a technique, a history, and a standard
    for doing it well: curating a feed, engaging in AI slop, spending on
    impulse, riding a trend before it dies, rage-baiting, going viral,
    spreading a claim you can't verify, and talking a language your
    lecturers can't follow. You leave having produced three graded
    artefacts — a forged scripture, a canonization case, and a portfolio of
    practicum evidence — and a doctrine of your own devising to set beside
    the twelve.
  </p>

  <h2>Who it is for</h2>
  <p>
    Postgraduates who already spend more time online than they'd admit in a
    job interview, and who'd rather study that habit seriously than pretend
    it isn't there. No prior theology is assumed; a working feed, a
    tolerance for satire, and a willingness to read scripture and a
    subreddit with the same rigour are the only prerequisites.
  </p>

  <h2>Where to go next</h2>
  <CardGrid columns={2}>
    <Card title={sessionLabels.plural} href="/sessions/">
      <p>The weekly schedule and what happens in each tutorial.</p>
    </Card>
    <Card title="Assessment" href="/assessments/">
      <p>What is marked, what it is worth, and when it is due.</p>
    </Card>
    <Card title="People" href="/people/">
      <p>Who teaches the course and how to reach them.</p>
    </Card>
  </CardGrid>
</ContentLayout>

<style>
  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0 2rem;
    padding: 0;
    list-style: none;
  }

  .course-tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }
</style>
